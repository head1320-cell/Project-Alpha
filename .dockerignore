# ── Node / Next.js (빌드 컨텍스트에서 제외 — Docker가 새로 빌드) ──
**/node_modules
**/.next
frontend/node_modules
frontend/.next
frontend/.turbo

# ── Python ──
**/__pycache__
**/*.pyc
**/*.pyo
.venv
venv

# ── 캐시 / 로그 / 임시 ──
*.log
*.bak
.git
.github
**/.DS_Store
*.tsbuildinfo

# ── 민감정보 (절대 이미지에 안 들어가게) ──
.env
src/data/corp_code_cache.json
src/data/corp_name_cache.json

# ── 테스트 / 문서 (런타임 불필요) ──
tests/__pycache__
*.md
