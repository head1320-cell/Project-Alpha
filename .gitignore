# ═══════════════════════════════════════════════════════════════
# Project Alpha — .gitignore (Windows/Linux 공통)
# ═══════════════════════════════════════════════════════════════

# 환경변수 / 비밀 (절대 커밋 금지)
.env
.env.local
.env.*.local
*.key
*.pem

# DART/KIS 캐시 (자동 생성, 용량 큼)
src/data/corp_code_cache.json
src/data/corp_name_cache.json
src/data/master_flags_cache.json

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ─── Node / Next.js (frontend) ───
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── 빌드 / 로그 / 임시 ───
*.log
*.bak
dist/
build/
.cache/

# ─── 데이터베이스 / 로컬 데이터 ───
*.sqlite
*.db
pg_data/

# ─── OS / 에디터 ───
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# ─── Docker 볼륨 ───
postgres_data/
