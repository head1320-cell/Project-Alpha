# ═══════════════════════════════════════════════════════════════
# Project Alpha — .gitignore (Windows/Linux 공통)
# ═══════════════════════════════════════════════════════════════

# 환경변수 / 비밀 (절대 커밋 금지)
.env
.env.local
.env.*.local
*.key
*.pem

# DART/KIS 캐시 (자동 생성, 용량 큼)
src/data/corp_code_cache.json
src/data/corp_name_cache.json
src/data/master_flags_cache.json

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ─── Node / Next.js (frontend) ───
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── 빌드 / 로그 / 임시 ───
*.log
*.bak
dist/
build/
.cache/

# ─── 데이터베이스 / 로컬 데이터 ───
*.sqlite
*.db
pg_data/

# ─── OS / 에디터 ───
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# ─── Docker 볼륨 ───
postgres_data/

# DART runtime response cache (per-deployment, not source)
src/data/dart_cache/
corp_code_cache.json

# 창업 지원서 초안 — ★저장소에 올리지 않는다★
# 개인 신청 문서이고 자체 평가(약점 진단)가 들어 있어, 저장소 링크를 공개하면
# 심사자가 읽을 수 있다. 커밋하면 나중에 지워도 기록에 남으므로 아예 추적하지
# 않는다. 로컬에는 그대로 남아 있다.
docs/응모/
