# ═══════════════════════════════════════════════════════════════════════════════
# FICC Quant Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# 사용법: cp .env.example .env  →  값 입력 후 docker compose up --build -d
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
PG_USER=ficc_user
PG_PASSWORD=ficc_password
PG_DATABASE=ficc_risk
PG_HOST=db
PG_PORT=5432

# Async driver URL (KIS data sync + v1 API 에서 사용)
DATABASE_URL_ASYNC=postgresql+asyncpg://ficc_user:ficc_password@db:5432/ficc_risk


# ─── KIS Open API (Stage 13 Live Trading) ────────────────────────────────────
# 동작 모드 — 가장 안전한 것부터:
#   1) KIS_USE_MOCK=1                  → MockKISClient (개발/테스트, 외부 호출 없음)
#   2) KIS_USE_MOCK=0, KIS_IS_PAPER=1  → KIS 모의투자 (가상 계좌)
#   3) KIS_USE_MOCK=0, KIS_IS_PAPER=0  → KIS 실계좌 ⚠ 실제 자금 거래
#   ★ 실데이터를 보려면 KIS_USE_MOCK=0 으로 변경 ★
#   데이터 조회(시세/일봉)는 모의·실계좌 모두 가능. 주문만 모드 구분.
KIS_USE_MOCK=1
KIS_IS_PAPER=1

# 인증 — https://apiportal.koreainvestment.com/ 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                   # 계좌번호 앞 8자리
KIS_ACCOUNT_PRDT=01               # 상품 코드 (위탁: 01)

# Rate limiter (Stage 13+ Priority Queue Gateway)
KIS_RATE_LIMIT=18                 # 초당 호출 한도 (KIS 공식 20, 안전 18)

# Base URL (자동 결정되지만 명시도 가능)
# Mock:  https://openapivts.koreainvestment.com:29443
# Real:  https://openapi.koreainvestment.com:9443


# ─── DART OpenAPI (재무제표 실데이터) ★실데이터 1순위★ ──────────────────────
# https://opendart.fss.or.kr/ 에서 인증키 신청 (무료, 즉시 발급)
# 설정 시: 35개 학술 펀더멘털 팩터(GP/A·Altman Z·F-Score 등)가 실제 재무로 계산
# 미설정 시: mock 자동 fallback (개발 정상 동작)
# 최초 실행 시 corpCode.xml(전체 상장사 매핑) 자동 다운로드 → corp_code_cache.json 캐시
DART_API_KEY=

# KRX 정보데이터시스템 OpenAPI (장기 백테스트 적재 — data.krx.co.kr에서 발급)
# 키가 있으면 백엔드 startup이 전종목 장기 일봉을 daily_prices에 자동 백필(데몬·재개 가능).
KRX_API_KEY=
KRX_AUTOBACKFILL=1          # 0이면 자동 백필 끔 (수동 python -m src.data.krx_ingest 만)
KRX_BACKFILL_START=2020-01-01   # 자동 백필 시작일 (멀수록 오래 — 10년≈50분, 데몬 비차단)

# KIS 기반 전종목 OHLCV 사전 적재 (KRX 키 없이도 daily_prices를 미리 채워 백테스터 즉시 가속)
#   KIS 실데이터(KIS_USE_MOCK=0 + 키) 이고 KRX 백필이 비활성일 때만 startup 데몬이 동작.
#   우선순위 kospi200→kosdaq150→전종목, 병렬(스레드 안전)·재개 가능(이미 적재분 스킵).
OHLCV_PREWARM=1             # 0이면 KIS 사전 적재 끔
OHLCV_PREWARM_ALL=1         # 0이면 전종목 확장 없이 공통 유니버스(kospi200+kosdaq150)까지만
OHLCV_PREWARM_DAYS=730      # 사전 적재 기간(일) — 약 2년치 일봉 (KIS 1콜 최대 ~600봉)
OHLCV_PREWARM_WORKERS=8     # 병렬 워커 수 (전역 RateLimiter 18/s 안에서 동작)

# 한국은행 ECOS OpenAPI (환율·금리 팩터 — ecos.bok.or.kr에서 무료 발급)
BOK_API_KEY=

# FRED OpenAPI (미국 국채금리 팩터 — fred.stlouisfed.org에서 무료 발급)
FRED_API_KEY=


# ─── Real-time Notifications (Stage 13+) ─────────────────────────────────────
# Slack: https://api.slack.com/messaging/webhooks
# Discord: 채널 설정 → Integrations → Webhooks
# 비워두면 알림은 로컬 로그로만 (시스템 정상 동작)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=


# ─── Frontend → Backend 연결 ─────────────────────────────────────────────────
# 권장: 비워둘 것. 비우면 브라우저는 같은 출처 프록시(/api/backend)를 사용한다.
#   → GCP/도메인/IP 무엇이든 그대로 동작 (IP baking·CORS·방화벽 :8000·mixed-content 불필요)
# 별도 API 도메인을 쓸 때만 절대 URL을 넣을 것 (예: https://api.example.com).
# ⚠ 이 값은 빌드 타임에 프론트 번들에 박힌다(런타임 변경 불가). GCP 빌드에서 이걸
#    localhost로 두면 배포 사이트가 API를 전혀 못 받아온다 → 그래서 기본 비움.
NEXT_PUBLIC_API_URL=

# Next 서버(런타임)가 /api/backend/* 를 백엔드로 프록시할 주소.
# docker compose 안: http://backend:8000 (기본). 단독 실행 시 백엔드 주소로.
BACKEND_URL=http://backend:8000

# 시장 스냅샷 파이프라인에서 yfinance 사용 여부 (기본 off).
# 클라우드 IP에서 yfinance는 429(rate limit)로 거의 실패 → 기본은 결정론적 mock 사용.
# 한국 스크리너는 KIS/DART/mock 경로라 이 값과 무관하게 동작한다.
MARKET_PIPELINE_USE_YFINANCE=0

# Anthropic API (Phase 3 AI Narrative — 향후)
ANTHROPIC_API_KEY=

# 환경 식별
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
